{
  "name": "serverless-ecommerce-backend",
  "version": "1.0.0",
  "description": "Serverless E-Commerce Backend System using AWS — MCA Final Project",
  "main": "handlers/auth.js",
  "scripts": {
    "test": "jest --testPathPattern=tests/ --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint handlers/ utils/",
    "build": "sam build --template ../infra/template.yaml",
    "deploy:dev": "sam deploy --config-env dev",
    "deploy:prod": "sam deploy --config-env prod"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["handlers/**/*.js"],
    "coverageReporters": ["text", "html"]
  },
  "engines": { "node": ">=18.0.0" },
  "author": "[Your Name]",
  "license": "MIT"
}
